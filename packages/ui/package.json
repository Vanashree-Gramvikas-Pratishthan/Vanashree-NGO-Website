{
  "name": "vanashree-ui",
  "version": "1.0.0",
  "author": "Vanashree Foundation",
  "repository": {
    "type": "git",
    "url": "https://github.com/Vanashree-Foundation/Vanashree-Landing-Page"
  },
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./index": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./button": {
      "import": "./dist/button/index.js",
      "require": "./dist/button/index.js",
      "types": "./dist/button/index.d.ts"
    },
    "./badge": {
      "import": "./dist/badge/index.js",
      "require": "./dist/badge/index.js",
      "types": "./dist/badge/index.d.ts"
    },
    "./card": {
      "import": "./dist/card/index.js",
      "require": "./dist/card/index.js",
      "types": "./dist/card/index.d.ts"
    },
    "./icon": {
      "import": "./dist/icon/index.js",
      "require": "./dist/icon/index.js",
      "types": "./dist/icon/index.d.ts"
    },
    "./separator": {
      "import": "./dist/separator/index.js",
      "require": "./dist/separator/index.js",
      "types": "./dist/separator/index.d.ts"
    },
    "./utils": {
      "import": "./dist/utils/index.js",
      "require": "./dist/utils/index.js",
      "types": "./dist/utils/index.d.ts"
    }
  },
  "scripts": {
    "build": "npm run clean && rollup -c",
    "clean": "rm -rf dist",
    "lint": "echo 'no lint configured yet'"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "react": "19.2.3",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "rollup": "^4.60.0",
    "rollup-plugin-dts": "^6.4.1",
    "tsup": "^8.5.1",
    "typescript": "^5"
  }
}
